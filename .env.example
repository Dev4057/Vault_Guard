# VaultGuard Environment Configuration

# PRIVATE KEY (Get from MetaMask: Account Details > Export Private Key)
# KEEP the 0x prefix!
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# RPC URLs
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Etherscan API Key (Get from https://etherscan.io/myapikey)
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Signer Addresses (Your wallet addresses that will be signers)
SIGNER_1=0xYOUR_ADDRESS_1
SIGNER_2=0xYOUR_ADDRESS_2
SIGNER_3=0xYOUR_ADDRESS_3
SIGNER_4=0xYOUR_ADDRESS_4
SIGNER_5=0xYOUR_ADDRESS_5

# Configuration
APPROVAL_THRESHOLD=3

# Deployed Contract Address (fill after deployment)
VAULT_ADDRESS=

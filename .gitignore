cd ~/Projects/vault_guard

# Create .gitignore if it doesn't exist
cat > .gitignore << 'EOF'
# Environment variables (CONTAINS PRIVATE KEYS!)
.env
*.env
.env.local
.env.production

# Foundry
cache/
out/
broadcast/

# Node modules
node_modules/
Frontend/node_modules/

# Build outputs
dist/
Frontend/dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temporary files
*.tmp
.cache/
EOF